{
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@rowcat/runtime": ["../runtime/src/index.ts"],
      "@rowcat/runtime/*": ["../runtime/src/*.ts"],
      "@rowcat/runtime-host": ["../runtime-host/src/index.ts"],
      "@rowcat/runtime-host/*": ["../runtime-host/src/*.ts"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
