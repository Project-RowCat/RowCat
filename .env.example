# Compose-only variables: `cp .env.example .env`, then fill in the per-deployment values. App
# settings live in docker-compose.yml's `environment`. Check what is on with `pnpm env:doctor --file
# .env --mode production` (values are not printed). `pnpm env:check` catches drift, and
# docs/ops/CONFIGURATION.md maps each file to its run mode.

# Ports are fixed in compose (3000/3001/5432/6379). Only web and api are published to the host.

# Origins (CSV) allowed to call the API from the browser, scheme included. A missing origin fails
# only in the browser console (the server still answers 200). Include the apps/admin console origin
# too, or every console lookup shows as a network error. Production: WEB_ORIGIN=https://example.com
WEB_ORIGIN=http://localhost:3000,http://localhost:3002

# --- Database -----------------------------------------------------------------
# The db service is initialized with these values; the api's DATABASE_URL is built from them. Change
# the password in production.
POSTGRES_USER=rowcat
POSTGRES_PASSWORD=rowcat
POSTGRES_DB=rowcat

# --- Redis (rate limiting) ----------------------------------------------------
# Counter store for distributed rate limiting. **Empty = in-process counters**: exact for one
# instance, but with two or more replicas the limit multiplies by the replica count (production
# boots with a warning). Optional so local dev and CI run without Redis. If you publish Redis's
# port, set --requirepass: it is otherwise unauthenticated.
REDIS_URL=redis://redis:6379

# --- Background jobs -----------------------------------------------------------
# Push delivery (every 30s) · orphan media cleanup and legal retention purge (daily). Off in code
# and on in compose, so laptops and CI do not each run a scheduler. Empty = compose default (on);
# `off` disables it for this deployment. Replicas are safe (Postgres advisory locks). Run a job by
# hand:
#   docker compose exec api node dist/jobs/cli.mjs run media.cleanup-orphans
#   docker compose exec api node dist/jobs/cli.mjs retention:inspect
# BACKGROUND_JOBS_ENABLED=on
#
# Daily job time and timezone. The host TZ is not read. The exact minute is not a correctness
# condition.
# BACKGROUND_JOBS_DAILY_AT=03:00
# BACKGROUND_JOBS_TIMEZONE=Asia/Seoul
#
# Retention purge in dry run (count only). Turn on for a few days after rollout, then off: left on,
# the promised purge silently never runs.
# LEGAL_RETENTION_DRY_RUN=on

# --- Auth ---------------------------------------------------------------------
# Session cookie signing key. compose will not start without it (no production default is made on
# purpose).
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Set only when web and api have different origins (example.com + api.example.com), so the cookie is
# scoped to the parent domain. Same origin: leave empty.
# AUTH_COOKIE_DOMAIN=.example.com
# Behind a CDN or load balancer, the login limiter needs these to read the client IP (see
# apps/api/.env.example).
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
# AUTH_IP_HEADER=cf-connecting-ip
# AUTH_TRUSTED_ORIGINS=https://example.com

# Google sign-in: enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple: all four values are required, and a partial set blocks boot. There is no
# secret to paste: the server signs a short-lived JWT from PRIVATE_KEY per request. CLIENT_ID is the
# Services ID (not the bundle id), whose Return URL is `<API_ORIGIN>/v2/auth/callback/apple`.
# PRIVATE_KEY is the **contents** of the .p8 file. Multi-line values must be double-quoted as-is, or
# have newlines written as \n: this parser reads only the first line of an unquoted multi-line
# value.
#   (1) APPLE_SIGN_IN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
#                                  MIGHAgEA...
#                                  -----END PRIVATE KEY-----"
#   (2) APPLE_SIGN_IN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGH...
# ⚠︎ Filling all four sends login data to Apple Inc. (US). Leave them empty unless the published
# privacy policy names Apple. Empty means the provider is not registered at all.
APPLE_SIGN_IN_CLIENT_ID=
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=

# Kakao sign-in: **the REST API key alone turns it on.** CLIENT_SECRET is optional in Kakao's
# console, so empty can be valid, but it must match the console (console on + empty = failed token
# exchange). REST_API_KEY is the **REST API key** from Kakao Developers > App Keys, never the Admin
# key. A wrong key fails only after sign-in completes on Kakao's screen. Register
# `<API_ORIGIN>/v2/auth/callback/kakao` as a Redirect URI, and add `<API_ORIGIN>` to Platform > Web
# site domains (not only the web domain), or you get KOE006. Consent must include Kakao account
# (email). ⚠︎ Sends login data to Kakao Corp. Leave empty unless the published privacy policy names
# Kakao.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# --- Outbound mail (transactional) ----------------------------------------------
# Auth mail transport: `smtp` | `dev` | empty (send nothing). **Setting this turns on email
# verification.** There is no separate switch: "requires verification but cannot send" would create
# accounts that can never sign in. `dev` writes links to the server console and is refused in
# production. Any SMTP provider works; the code does not pick one.
MAIL_TRANSPORT=

# Sender. Required for `smtp`. e.g. RowCat <no-reply@example.com>
MAIL_FROM=

# SMTP. HOST is required for `smtp`. PORT empty = 587 (STARTTLS); for 465, also
# set SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# Unauthenticated relay: leave both empty. Filling only one blocks boot.
SMTP_USER=
SMTP_PASSWORD=

# Opens password reset: `on` | empty (closed). Needs MAIL_TRANSPORT; mail alone never opens it.
# Leave empty unless the published privacy policy lists reset mail.
PASSWORD_RESET_ENABLED=

# --- Native push (delivery plane) ----------------------------------------------
# Push transport: `expo` | empty (send nothing). Empty is the default and the inbox still works;
# delivery records are still written. Empty also keeps local dev from pushing to real devices. ⚠️
# Setting this also requires BACKGROUND_JOBS_ENABLED=on. Without it, deliveries are created and
# nothing is sent, with no visible symptom.
PUSH_TRANSPORT=

# Expo access token (optional; required if Expo's push security is on). **Secret**: never logged or
# returned.
EXPO_ACCESS_TOKEN=

# --- Passkeys (WebAuthn) -------------------------------------------------------
# Security boundaries. Empty = derived from WEB_ORIGIN, which is normally right. Set the RP ID only
# to share passkeys across subdomains (e.g. example.com). rpID must cover every host in
# WEBAUTHN_ORIGIN (or WEB_ORIGIN), or boot fails; a mismatch makes the browser refuse registration
# with nothing in the log.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# Name shown in the browser's passkey list. Empty = RowCat.
WEBAUTHN_RP_NAME=

# --- Mobile OTA publishing (CI trigger) -------------------------------------------
# The console's "new OTA release" and "rollback" trigger the GitHub Actions workflow mobile-ota.yml,
# which is not in this repository (example: docs/ota/example-workflows.md). **Set all three or
# none**; a partial set blocks boot. Empty: the console can still read, roll out, pause and resume;
# publish with `pnpm mobile:update`. This token is not a signing credential (the key stays in CI)
# and can write Actions for this repository only. It also requires BACKGROUND_JOBS_ENABLED=on
# (reconciles lost reports).
# OTA_CI_GITHUB_REPOSITORY=owner/repo
# OTA_CI_GITHUB_TOKEN=github_pat_...
# OTA_CI_CHANNELS=production

# Public origin of this API. The reverse proxy forwards this domain to container port 3001. The code
# appends /v2, so enter the origin only (e.g. https://api.example.com).
API_ORIGIN=http://localhost:3001

# --- Conversation generation ---------------------------------------------------
# Platform model key: server-only, never sent to browsers. Empty: only generation returns 503
# (chat_provider_unconfigured); the gallery and login still work. Fake responses are deliberately
# not produced.
OPENROUTER_API_KEY=

# Models are not deployment config. Managed models come from the catalog (GET /v2/chat/models); the
# public-id to upstream-slug table is apps/api/src/services/managed-models.ts, and the default model
# is DEFAULT_MANAGED_MODEL in @rowcat/contracts.
#
# Provider endpoint. Set only to route through a staging proxy (empty = code default).
# OPENROUTER_BASE_URL=

# Who may use managed generation: `allowlist` | `everyone`. Empty = allowlist. The public
# distribution has no metering: this key's bill is limited only by the per-member rate limit and
# this allowlist.
#   allowlist   members with member.managed_generation_allowed = true, plus staff and admin.
#               Others get 403 (chat_managed_not_allowed) and connect their own key in AI settings.
#               Admins toggle it in the console's member detail.
#   everyone    every signed-in member; only the rate limit remains.
# Unknown values block boot.
# MANAGED_GENERATION_ACCESS=allowlist

# --- Identity verification ----------------------------------------------------
# One setting opens **two consumers**: guardian consent (signup of members under 14) and adult
# eligibility. Empty: no provider: both return 503 (fail-closed), so under-14 members cannot start
# and no adult entitlement is granted. `portone` | `dev`. `dev` passes everyone and boot refuses it
# under NODE_ENV=production; to walk the flows locally, run `pnpm dev:api` with it set in
# apps/api/.env instead of compose.
# IDENTITY_VERIFICATION_PROVIDER=portone

# PortOne V2: **all three** must be set. A partial set would fail halfway through the flow, so the
# server answers 503 up front. The first two are public values for the browser (admin console >
# integration info). The third is the only secret and the sole key to read verification results: if
# it leaves the server, anyone can read others' results.
PORTONE_STORE_ID=
PORTONE_IDENTITY_CHANNEL_KEY=
PORTONE_V2_API_SECRET=

# --- Membership (age gate) -------------------------------------------------------
# `on`: members who have not confirmed their age get an entry gate. Empty = off (the default). Turn
# on only after schema, server, screens and legal documents are deployed
# (docs/membership/ARCHITECTURE.md). It does not apply to members already confirmed as under 14: off
# means "not asking yet", not "the law is off".
# MEMBERSHIP_AGE_GATE=on
# Adult viewing closes one year after adult verification (Youth Protection Act Enforcement Decree,
# Art. 17(2)). Leave empty unless the published adult-safety policy states this. Turning it on for
# existing members needs 30 days' notice.
# ADULT_REVERIFICATION_ENABLED=on

# --- Web (SSR) ------------------------------------------------------------------
# Address the web's **server-side render** uses to call the API. It is a runtime value, never in the
# browser bundle (the browser uses VITE_API_ORIGIN). Inside the container, localhost is the
# container itself, so use the service name. Empty = http://api:3001.
# API_INTERNAL_ORIGIN=http://api:3001

# API origin the browser calls, for both the web and the operations console. A **runtime** value:
# the containers hand it to the browser when they start, so the published images serve any
# deployment and changing it needs only `docker compose up -d web admin`, no rebuild. Empty falls back
# to http://localhost:3001, so a production deployment must set its real domain.
VITE_API_ORIGIN=http://localhost:3001

# Operations console origin. It drives the "operator tools" link for accounts with a role.
# **No production default**: the console is usually on a separate host, and a guessed address would
# silently break when the deployment moves. Empty = link not drawn. The dev server uses
# http://localhost:3002 regardless. Runtime, like VITE_API_ORIGIN.
# VITE_ADMIN_ORIGIN=https://admin.example.com

# Which images compose runs. `docker compose up` pulls these and builds from this checkout only when
# the image is not found; `docker compose up --build` always builds. A fork publishing its own images
# (.github/workflows/images.yml) points the registry at them; pin a tag (`sha-<commit>`) to stop
# `latest` moving under a deployment.
# ROWCAT_IMAGE_REGISTRY=ghcr.io/project-rowcat/rowcat
# ROWCAT_IMAGE_TAG=latest

# Delegates `docker compose build` to buildx bake, so shared stages (base, manifests) are not built
# twice.
COMPOSE_BAKE=true

# For multi-arch builds or cache export, create a docker-container driver builder and select it:
#   docker buildx create --name rowcat --driver docker-container --bootstrap
# BUILDX_BUILDER=rowcat
