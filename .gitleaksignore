# gitleaks allowlist — every line is a value that is not a secret, checked by a person.
# Fingerprints carry the line number on purpose: if a line moves or a new value appears, the scan
# reports it again and someone has to look at it again (a path-wide allowlist would hide a real key
# pasted into the same file).
#
#   docker run --rm -v "$PWD:/repo:ro" -w /repo zricethezav/gitleaks:v8.21.2 detect --no-git --source . --redact

# How to write the Apple .p8 key: a `MIGH...` placeholder, not a key.
.env.example:private-key:70
apps/api/.env.example:private-key:81
# The key is generated by the test at run time (p256()); the literal is only the PEM frame.
apps/api/src/lib/apple-signin-config.test.ts:private-key:128
# A fake BYO key the local credential store test seals and opens.
apps/web/src/lib/local-provider/store.test.ts:generic-api-key:34
# Sync crypto golden vectors: fixed, public test inputs (counting bytes), not keys anyone uses.
packages/sync/src/__fixtures__/vectors.json:generic-api-key:12
packages/sync/src/__fixtures__/vectors.json:generic-api-key:55
