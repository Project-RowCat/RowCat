    "@types/node": "^22.10.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "vitest": "^3.2.4"
  },
  "main": "dist/main.mjs",
