{
	"name": "@rowcat/api",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/index.ts",
		"build": "tsdown",
		"email:dev": "email dev --dir src/services/mail/emails --port 3005",
		"env:check": "tsx src/config/cli.ts check",
		"env:doctor": "tsx src/config/cli.ts doctor",
		"start": "node dist/index.mjs",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"jobs:list": "tsx --env-file-if-exists=.env src/jobs/cli.ts list",
		"jobs:run": "tsx --env-file-if-exists=.env src/jobs/cli.ts run",
		"jobs:retention:inspect": "tsx --env-file-if-exists=.env src/jobs/cli.ts retention:inspect",
		"db:studio": "drizzle-kit studio",
		"db:seed:play": "tsx --env-file-if-exists=.env src/db/seed-play.ts",
		"db:seed:e2e": "tsx --env-file-if-exists=.env src/db/seed-e2e.ts",
		"db:seed:dev-user": "tsx --env-file-if-exists=.env src/db/seed-dev-user.ts",
		"db:seed:moderator": "tsx --env-file-if-exists=.env src/db/seed-moderator.ts",
		"guardian:revoke": "tsx --env-file-if-exists=.env src/db/revoke-guardian-consent.ts",
		"mobile-updates": "tsx --env-file-if-exists=.env src/services/mobile-updates/cli.ts",
		"test": "vitest run && vitest run --config vitest.mail.config.ts"
	},
	"dependencies": {
		"@apple/app-store-server-library": "^3.1.0",
		"@better-auth/expo": "1.7.2",
		"@better-auth/passkey": "1.7.2",
		"@hono/node-server": "^2.1.1",
		"@rowcat/authoring": "workspace:*",
		"@rowcat/chat": "workspace:*",
		"@rowcat/contracts": "workspace:*",
		"@rowcat/domain": "workspace:*",
		"@rowcat/runtime": "workspace:*",
		"@rowcat/runtime-compiler": "workspace:*",
		"@rowcat/sync": "workspace:*",
		"better-auth": "1.7.2",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.2",
		"ioredis": "^5.11.1",
		"nodemailer": "^9.1.1",
		"pg": "^8.23.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-email": "^6.9.2",
		"sharp": "^0.35.3",
		"typescript-compiler-api": "npm:typescript@5.9.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@react-email/ui": "^6.9.2",
		"@types/node": "^22.10.2",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"drizzle-kit": "^0.31.10",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.12",
		"vite": "^8.0.0",
		"vitest": "^3.2.4"
	}
}
