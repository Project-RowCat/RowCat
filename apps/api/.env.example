# Values read when this API runs directly (`pnpm dev:api`). Fill them in after `cp .env.example
# .env`. The root .env belongs to docker compose and is not loaded by this process. Check what is
# on: `pnpm env:doctor --file apps/api/.env`. `pnpm env:check` catches drift from the runtime schema
# (docs/ops/CONFIGURATION.md).

# Server binding. Containers bind 0.0.0.0 instead.
HOST=127.0.0.1
PORT=3001

# Origins (CSV) allowed to call this API from the browser. `*` is not allowed with credentials. A
# missing origin fails only in the browser console (the server still answers 200; the log shows only
# a `[cors]` warning). Include the apps/admin console origin too, or every console lookup shows as a
# network error. Production: https://example.com. Include the scheme (a missing scheme blocks boot).
WEB_ORIGIN=http://localhost:3000,http://localhost:3002

# Origin this API is reachable at from outside. /v2 is appended by the code, so enter the origin
# only. Production example: https://api.example.com  ->  https://api.example.com/v2
API_ORIGIN=http://localhost:3001

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgres://rowcat:rowcat@localhost:5432/rowcat
# Connection cap per instance. Across N instances, the DB sees N x this value.
DATABASE_POOL_MAX=10

# --- Redis (rate limiting) ----------------------------------------------------
# Counter store for distributed rate limiting. **Empty = in-process counters**: exact for one
# instance, which is right for local development. With two or more replicas the limit multiplies by
# the replica count.
# REDIS_URL=redis://127.0.0.1:6379

# --- Background jobs -----------------------------------------------------------
# Push delivery (every 30s) · orphan media cleanup and legal retention purge (daily). **Off by
# default** because one job makes irreversible purges and another pushes to real devices; if they
# ran just because a module was imported, every laptop and CI would run a scheduler. To run one job
# once:
#   pnpm --filter @rowcat/api jobs:list
#   pnpm --filter @rowcat/api jobs:run media.cleanup-orphans
# BACKGROUND_JOBS_ENABLED=on

# Daily job time and timezone. The host TZ is not read. A mistyped timezone blocks boot, because the
# symptom of a silent error would be "it never runs".
# BACKGROUND_JOBS_DAILY_AT=03:00
# BACKGROUND_JOBS_TIMEZONE=Asia/Seoul

# Retention purge in dry run (count only). Left on and forgotten, the promised purge never runs, and
# nothing shows it.
# LEGAL_RETENTION_DRY_RUN=on

# --- Auth (Better Auth) -------------------------------------------------------
# Session cookie signing key. Boot fails in production if it is empty.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origins (CSV) allowed as post-login return targets. Empty = WEB_ORIGIN. Production
# example: AUTH_TRUSTED_ORIGINS=https://example.com
# AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Set only when web and API origins differ (e.g. example.com and api.example.com). Same origin:
# leave empty; setting it locally stops cookies from being stored.
# AUTH_COOKIE_DOMAIN=.example.com

# The login and signup limiters read client IP through these. Behind a CDN or load balancer, one of
# the two is required. Without them, X-Forwarded-For can bypass the limiter, or every client shares
# one bucket and one attacker locks out the whole login.
#   TRUSTED_PROXIES: proxy IPs or CIDRs (CSV). The chain is walked right to left;
#                    the first untrusted hop is the client.
#   IP_HEADER: the one header the proxy overwrites (Cloudflare: cf-connecting-ip).
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
# AUTH_IP_HEADER=cf-connecting-ip

# Google sign-in: enabled only when both values are set (a half configuration gives runtime 500s).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple: all four values are required, and a partial set blocks boot. There is no
# secret to paste: the server signs a short-lived JWT from PRIVATE_KEY per request. CLIENT_ID is the
# Services ID (not the bundle id), whose Return URL is `<API_ORIGIN>/v2/auth/callback/apple`.
# PRIVATE_KEY is the **contents** of the .p8 file. Multi-line values must be double-quoted as-is, or
# have newlines written as \n: this file's parser reads only the first line of an unquoted
# multi-line value.
#   (1) APPLE_SIGN_IN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
#                                  MIGHAgEA...
#                                  -----END PRIVATE KEY-----"
#   (2) APPLE_SIGN_IN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGH...
# ⚠︎ Filling all four sends login data to Apple Inc. (US). Leave them empty unless your deployment's
# privacy policy names Apple. Empty means the provider is not registered at all.
APPLE_SIGN_IN_CLIENT_ID=
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=

# Kakao sign-in: **the REST API key alone turns it on.** CLIENT_SECRET is optional in Kakao's
# console, so empty can be valid, but it must match the console (console on + empty = failed token
# exchange). REST_API_KEY is the **REST API key** from Kakao Developers > App Keys, never the Admin
# key. A wrong key fails only after sign-in completes on Kakao's screen. Register
# `<API_ORIGIN>/v2/auth/callback/kakao` as a Redirect URI, and add `<API_ORIGIN>` to Platform > Web
# site domains (not only the web domain), or you get KOE006. Consent must include Kakao account
# (email). ⚠︎ Sends login data to Kakao Corp. Leave empty unless the published privacy policy names
# Kakao.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# --- Outbound mail (transactional) ----------------------------------------------
# Auth mail transport: `smtp` | `dev` | empty (send nothing). **Setting this turns on email
# verification.** There is no separate switch: "requires verification but cannot send" would create
# accounts that can never sign in. `dev` writes links to the server console and is refused in
# production. Any SMTP provider works; the code does not pick one.
MAIL_TRANSPORT=

# Sender. Required for `smtp`. e.g. RowCat <no-reply@example.com>
MAIL_FROM=

# SMTP. HOST is required for `smtp`. PORT empty = 587 (STARTTLS); for 465, also
# set SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# Unauthenticated relay: leave both empty. Filling only one blocks boot.
SMTP_USER=
SMTP_PASSWORD=

# Opens password reset: `on` | empty (closed). Needs MAIL_TRANSPORT; mail alone never opens it.
# Turn it on only if your deployment's own privacy policy lists the reset mail.
PASSWORD_RESET_ENABLED=

# --- Native push (delivery plane) ----------------------------------------------
# Push transport: `expo` | empty (send nothing). Empty is the default and the inbox still works;
# delivery records are still written. Empty also keeps local dev from pushing to real devices. ⚠️
# Setting this also requires BACKGROUND_JOBS_ENABLED=on. Without it, deliveries are created and
# nothing is sent, with no visible symptom.
PUSH_TRANSPORT=

# Expo access token (optional; required if Expo's push security is on). **Secret**: never logged or
# returned.
EXPO_ACCESS_TOKEN=

# --- Passkeys (WebAuthn) -------------------------------------------------------
# Empty: derived from WEB_ORIGIN, which is normally right. Set the RP ID only to share passkeys
# across subdomains (e.g. example.com). rpID must cover every host in WEBAUTHN_ORIGIN (or
# WEB_ORIGIN), or boot fails; a mismatch makes the browser refuse registration with nothing in the
# server log.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=

# --- Mobile OTA publishing (CI trigger) -------------------------------------------
# The console's "new OTA release" and "rollback" trigger the GitHub Actions workflow mobile-ota.yml,
# which is not in this repository (example: docs/ota/example-workflows.md). **Set all three or
# none**; a partial set blocks boot. Empty: the console can still read, roll out, pause and resume;
# publish with `pnpm mobile:update`. This token is not a signing credential (the key stays in CI)
# and can write Actions for this repository only. It also requires BACKGROUND_JOBS_ENABLED=on
# (reconciles lost CI reports).
# OTA_CI_GITHUB_REPOSITORY=owner/repo
# OTA_CI_GITHUB_TOKEN=github_pat_...
# OTA_CI_CHANNELS=production

# --- Conversation generation provider ----------------------------------------
# Platform model key: server-only. If it reached the browser, anyone could call the model on this
# account. Empty: the generation endpoint returns 503 (chat_provider_unconfigured). Fake responses
# are deliberately not produced.
OPENROUTER_API_KEY=

# Models are not deployment config. Managed models come from the catalog (GET /v2/chat/models); the
# public-id to upstream-slug table is apps/api/src/services/managed-models.ts, and the default model
# is DEFAULT_MANAGED_MODEL in @rowcat/contracts.

# Provider endpoint. Set only to route through a staging proxy (empty = code default).
# OPENROUTER_BASE_URL=

# Who may use managed generation: `allowlist` | `everyone`. Empty = allowlist. No metering here:
# this key's bill is limited only by the per-member rate limit and this allowlist.
#   allowlist   members with member.managed_generation_allowed = true, plus staff and admin.
#               Others get 403 (chat_managed_not_allowed) and connect their own key in AI settings.
#               For solo local testing, everyone is convenient.
#   everyone    every signed-in member; only the rate limit remains.
# Unknown values block boot.
# MANAGED_GENERATION_ACCESS=allowlist

# --- Identity verification -----------------------------------------------------
# One setting opens **two consumers**: guardian consent (signup of members under 14) and a member's
# own adult eligibility check. The judgments differ but share one adapter, so a value set for one
# opens the other too. Provider: `portone` | `dev`. Empty = no provider: both return 503
# (fail-closed), so under-14 members cannot start and no adult entitlement is granted. `dev` passes
# everyone and boot refuses it under NODE_ENV=production; set it here to walk the flows locally.
IDENTITY_VERIFICATION_PROVIDER=

# PortOne V2: **all three** must be set. A partial set would fail halfway through the flow, so the
# server answers 503 up front. The first two are public values for the browser (admin console >
# integration info). The third is the only secret and the sole key to read verification results: if
# it leaves the server, anyone can read others' results. Guardian consent and adult verification
# share this channel. Splitting it later belongs in the config and handoff layer, not now: an extra
# unfilled variable would fail half-configured deployments silently.
PORTONE_STORE_ID=
PORTONE_IDENTITY_CHANNEL_KEY=
PORTONE_V2_API_SECRET=

# --- Membership (age gate) ----------------------------------------------------
# `on`: members who have not confirmed their age get an entry gate. Empty = off (the default). Turn
# on only after schema, server, screens and legal documents are deployed
# (docs/membership/ARCHITECTURE.md). It does not apply to members already confirmed as under 14: off
# means "not asking yet", not "the law is off".
MEMBERSHIP_AGE_GATE=
# Adult viewing closes one year after adult verification (Youth Protection Act Enforcement Decree,
# Art. 17(2)). Leave empty unless the published adult-safety policy states this. Turning it on for
# existing members needs 30 days' notice.
ADULT_REVERIFICATION_ENABLED=
